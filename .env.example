PORT=5002
NODE_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cocpit_backend_uat
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional Environment-specific DB settings
STAGING_DB_NAME=cocpit_backend
UAT_DB_NAME=cocpit_backend_uat
PROD_DB_NAME=cocpit_backend

# Isolated Admin JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Internal Inter-service Communication
INTERNAL_API_SECRET=your_internal_api_secret_here
MAIN_API_URL=http://localhost:5000

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Resend Mail Provider
RESEND_API_KEY=your_resend_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
